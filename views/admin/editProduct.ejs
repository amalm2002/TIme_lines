        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('editProductForm');
                const imageInput = document.getElementById('images');
                const existingImagesContainer = document.getElementById('existingImages');
                const imagePreviews = document.getElementById('imagePreviews');
                const croppingArea = document.getElementById('croppingArea');

                let cropper;
                let currentImage;
                let fileList = [];
                let existingImages = [];
                let removedImages = [];

                function populateExistingImages() {
                    existingImages = Array.from(existingImagesContainer.querySelectorAll('img'))
                        .map(img => img.src);
                }
                populateExistingImages();

                imageInput.addEventListener('change', function () {
                    const newFiles = Array.from(this.files);

                    if (newFiles.length === 0) return;

                    const currentTotal = existingImages.length + fileList.length;
                    const wouldBeTotal = currentTotal + newFiles.length;

                    if (wouldBeTotal > 3) {
                        alert(`Maximum 3 images allowed. You currently have ${currentTotal} selected.`);
                        this.value = '';
                        return;
                    }

                    newFiles.forEach(file => fileList.push(file));

                    displaySelectedImages();

                    this.value = '';
                });

                function displaySelectedImages() {
                    imagePreviews.innerHTML = '';
                    fileList.forEach((file, index) => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const container = document.createElement('div');
                            container.className = 'image-preview-container mb-3 d-flex align-items-center';

                            container.innerHTML = `
                        <img src="${e.target.result}" class="img-thumbnail me-2" style="max-width: 150px; max-height: 150px;">
                        <button type="button" class="btn btn-primary btn-sm me-1 crop-image">Crop</button>
                        <button type="button" class="btn btn-danger btn-sm remove-image">Remove</button>
                    `;

                            imagePreviews.appendChild(container);

                            container.querySelector('.crop-image').addEventListener('click', () => startCrop(container.querySelector('img')));
                            container.querySelector('.remove-image').addEventListener('click', () => removeNewImage(container, index));
                        };
                        reader.readAsDataURL(file);
                    });
                }

                function startCrop(imgElement) {
                    document.getElementById('cropImage').src = imgElement.src;
                    croppingArea.classList.remove('d-none');
                    currentImage = imgElement;

                    if (cropper) cropper.destroy();

                    cropper = new Cropper(document.getElementById('cropImage'), {
                        aspectRatio: 1,
                        viewMode: 2,
                        autoCropArea: 1,
                        responsive: true,
                        background: false,
                        zoomable: true,
                    });
                }

                function removeNewImage(container, index) {
                    fileList.splice(index, 1);
                    container.remove();

                    displaySelectedImages();
                }

                document.getElementById('saveCroppedImage').addEventListener('click', function () {
                    if (!cropper || !currentImage) return;

                    cropper.getCroppedCanvas({
                        width: 800,
                        height: 800
                    }).toBlob(blob => {
                        if (blob) {
                            const croppedFile = new File([blob], "cropped_image.jpg", { type: "image/jpeg" });

                            const previewContainers = imagePreviews.querySelectorAll('.image-preview-container');
                            for (let i = 0; i < previewContainers.length; i++) {
                                if (previewContainers[i].querySelector('img') === currentImage) {
                                    fileList[i] = croppedFile;
                                    break;
                                }
                            }

                            currentImage.src = URL.createObjectURL(blob);
                        }

                        cropper.destroy();
                        cropper = null;
                        croppingArea.classList.add('d-none');
                    }, 'image/jpeg', 0.95);
                });

                document.getElementById('cancelCrop').addEventListener('click', function () {
                    if (cropper) {
                        cropper.destroy();
                        cropper = null;
                    }
                    croppingArea.classList.add('d-none');
                });

                existingImagesContainer.addEventListener('click', function (e) {
                    if (e.target.classList.contains('remove-existing-image')) {
                        const container = e.target.closest('.existing-image-container');
                        const imgSrc = container.querySelector('img').src;

                        removedImages.push(imgSrc);
                        container.remove();

                        document.querySelectorAll('.existing-image-container').forEach((el, i) => {
                            el.setAttribute('data-index', i);
                            el.querySelector('.remove-existing-image').setAttribute('data-index', i);
                        });

                        existingImages = Array.from(existingImagesContainer.querySelectorAll('img'))
                            .map(img => img.src);
                    }
                });

                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    if (existingImages.length + fileList.length !== 3) {
                        Swal.fire('Error', `You must have exactly 3 images. Current total: ${existingImages.length + fileList.length}`, 'error');
                        return;
                    }

                    const name = document.getElementById('name').value.trim();
                    const brand = document.getElementById('brand').value.trim();
                    const modelNumber = document.getElementById('modelNumber').value.trim();
                    const category = document.getElementById('category').value.trim();
                    const price = document.getElementById('price').value.trim();
                    const productOffer = document.getElementById('productOffer').value.trim()
                    const offerEndDate = document.getElementById('offerEndDate').value.trim()
                    const stockQuantity = document.getElementById('stockQuantity').value.trim();
                    const description = document.getElementById('description').value.trim();
                    const images = document.getElementById('images').files;

                    if (!name || !brand || !modelNumber || !category || !price || !stockQuantity || !description) {
                        showErrorMessages({ name, brand, modelNumber, category, price, stockQuantity, description });
                        return;
                    }

                    if (productOffer && (!offerEndDate || offerEndDate === '')) {
                        document.getElementById('offerEndDateError').textContent = 'Offer end date is required when offer is provided.';
                        document.getElementById('offerEndDateError').style.color = 'red';
                        return;
                    } else {
                        document.getElementById('offerEndDateError').textContent = '';
                    }

                    if (productOffer) {
                        if (parseFloat(productOffer) > parseFloat(price)) {
                            document.getElementById('productOfferError').textContent = 'Offer price cannot be greater than the actual price.';
                            document.getElementById('productOfferError').style.color = 'red';
                            return;
                        } else {
                            document.getElementById('productOfferError').textContent = '';
                        }

                        const offerEndDateObj = new Date(offerEndDate);
                        const today = new Date();
                        if (offerEndDateObj <= today) {
                            document.getElementById('offerEndDateError').textContent = 'Offer end date must be a future date.';
                            document.getElementById('offerEndDateError').style.color = 'red';
                            return;
                        } else {
                            document.getElementById('offerEndDateError').textContent = '';
                        }
                    }

                    const formData = new FormData();

                    formData.append('name', document.getElementById('name').value.trim());
                    formData.append('brand', document.getElementById('brand').value);
                    formData.append('modelNumber', document.getElementById('modelNumber').value.trim());
                    formData.append('category', document.getElementById('category').value);
                    formData.append('price', document.getElementById('price').value);
                    formData.append('productOffer', document.getElementById('productOffer').value || 0);
                    formData.append('offerEndDate', document.getElementById('offerEndDate').value);
                    formData.append('stockQuantity', document.getElementById('stockQuantity').value);
                    formData.append('warranty', document.getElementById('warranty').value.trim());
                    formData.append('description', document.getElementById('description').value.trim());

                    existingImages.forEach(url => formData.append('existingImages', url));
                    fileList.forEach(file => formData.append('images', file));
                    removedImages.forEach(url => formData.append('removedImages', url));

                    try {
                        const response = await fetch(`/admin/editProduct/${document.getElementById('editProductId').value}`, {
                            method: 'PUT',
                            body: formData
                        });

                        const result = await response.json();

                        if (response.ok) {
                            Swal.fire('Success', 'Product updated successfully!', 'success').then(() => {
                                window.location.href = '/admin/products';
                            });
                        } else {
                            Swal.fire('Error', result.error || 'Failed to update product', 'error');
                        }
                    } catch (err) {
                        console.error('Submit error:', err);
                        Swal.fire('Error', 'Something went wrong. Check console.', 'error');
                    }
                });
            });

            function showErrorMessages(fields) {
                for (const [field, value] of Object.entries(fields)) {
                    const errorElement = document.getElementById(`${field}Error`);
                    if (!value) {
                        errorElement.textContent = `Please enter ${field}`;
                        errorElement.style.color = 'red';
                    } else {
                        errorElement.textContent = '';
                    }
                }
            }
        </script>


    </body>

    </html>